FROM golang:1.24-bookworm AS builder

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 go build -o /out/whisper-oai ./cmd/whisper-oai

FROM alpine:3.21

RUN apk add --no-cache ffmpeg

COPY --from=builder /out/whisper-oai /usr/local/bin/whisper-oai

EXPOSE 8000

ENTRYPOINT ["whisper-oai", "serve", "--host", "0.0.0.0", "--port", "8000"]
